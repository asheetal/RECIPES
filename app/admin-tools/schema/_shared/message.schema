{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "triage://shared/message",
  "title": "One conversation message",
  "type": "object",
  "required": ["role", "content"],
  "properties": {
    "role": {"enum": ["system", "user", "assistant"]},
    "content": {"type": "string"}
  },
  "additionalProperties": false
}
