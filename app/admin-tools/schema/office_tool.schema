{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "triage://tool/office",
  "title": "Office tool call (passive executor, author fixed 'ra')",
  "type": "object",
  "required": ["op"],
  "properties": {
    "op": {"enum": [
      "tracked_replace", "tracked_delete",
      "comment_new", "comment_reply",
      "tracked_accept", "tracked_reject",
      "list_comments", "list_changes",
      "xlsx_set_cell", "pptx_set_text"
    ]},
    "input": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "paragraph": {"type": "integer", "minimum": 1},
    "slide": {"type": "integer", "minimum": 1},
    "sheet": {"type": "string", "minLength": 1},
    "cell": {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]*$"},
    "old": {"type": "string", "minLength": 1},
    "new": {"type": "string"},
    "anchor": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "comment_id": {"type": "string", "minLength": 1},
    "value": {"type": ["string", "number", "null"]},
    "ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"op": {"enum": ["list_comments", "list_changes"]}}, "required": ["op"]},
     "then": {"required": ["input"]}},
    {"if": {"properties": {"op": {"const": "tracked_replace"}}, "required": ["op"]},
     "then": {"required": ["input", "sha256", "paragraph", "old", "new"]}},
    {"if": {"properties": {"op": {"const": "tracked_delete"}}, "required": ["op"]},
     "then": {"required": ["input", "sha256", "paragraph", "old"]}},
    {"if": {"properties": {"op": {"const": "comment_new"}}, "required": ["op"]},
     "then": {"required": ["input", "sha256", "paragraph", "anchor", "text"]}},
    {"if": {"properties": {"op": {"const": "comment_reply"}}, "required": ["op"]},
     "then": {"required": ["input", "sha256", "comment_id", "text"]}},
    {"if": {"properties": {"op": {"enum": ["tracked_accept", "tracked_reject"]}}, "required": ["op"]},
     "then": {"required": ["input", "sha256", "ids"]}},
    {"if": {"properties": {"op": {"const": "xlsx_set_cell"}}, "required": ["op"]},
     "then": {"required": ["input", "sha256", "sheet", "cell", "value"]}},
    {"if": {"properties": {"op": {"const": "pptx_set_text"}}, "required": ["op"]},
     "then": {"required": ["input", "sha256", "slide", "paragraph", "old", "new"]}}
  ]
}
