{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "triage://boundary/surgery_out",
  "title": "SURGEON -> handoff",
  "type": "object",
  "required": ["contractVersion", "status", "draft", "tools", "files", "errors"],
  "properties": {
    "contractVersion": {"const": 1},
    "status": {"enum": ["returned", "needs_resolution", "paused"]},
    "draft": {"type": "string"},
    "tools": {"type": "array", "items": {"$ref": "triage://shared/tool_record"}},
    "files": {"type": "array", "items": {"$ref": "triage://shared/file_record"}},
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
