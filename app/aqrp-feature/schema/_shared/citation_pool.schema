{ "$schema":"http://json-schema.org/draft-07/schema#", "$id":"aqrp://shared/citation_pool",
  "type":"object",
  "required":["pool_id","query","n_returned","top_k","ranking_rule"],
  "properties":{
    "pool_id":{"type":"string","pattern":"^P\\d+$"},
    "query":{"type":"string","minLength":1},
    "n_returned":{"type":"integer","minimum":0},
    "top_k":{"type":"array","minItems":1,"items":{"$ref":"aqrp://shared/citation_record"}},
    "ranking_rule":{"type":"string","minLength":1}
  },
  "additionalProperties":true }
