{ "$schema":"http://json-schema.org/draft-07/schema#", "$id":"aqrp://shared/citation_record",
  "type":"object",
  "required":["authors","year","title","journal","doi"],
  "properties":{
    "authors":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "year":{"type":"integer"},
    "title":{"type":"string","minLength":1},
    "journal":{"type":"string","minLength":1},
    "doi":{"type":"string","pattern":"^10\\."}
  },
  "additionalProperties":true }
