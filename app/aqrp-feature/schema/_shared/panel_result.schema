{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aqrp://shared/panel_result",
  "type": "object",
  "required": [
    "panel",
    "n",
    "responses"
  ],
  "properties": {
    "panel": {
      "type": "string"
    },
    "n": {
      "type": "integer",
      "minimum": 1
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "coder_id",
          "rows"
        ],
        "properties": {
          "coder_id": {
            "type": "string",
            "minLength": 1
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "record_id"
              ],
              "properties": {
                "record_id": {
                  "type": "string",
                  "minLength": 1
                },
                "codes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "quote": {
                  "type": "string"
                },
                "narrative": {
                  "type": "string"
                },
                "changes_dimension": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "description": "Semantic rule (pipeline.cjs): responses.length === n; no duplicate (record_id,coder_id); coders cover same record set; unresolved pair emitted as codes:['NA']."
}