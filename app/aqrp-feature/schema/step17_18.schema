{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aqrp://step17_18",
  "title": "AQRP step 17 (panel) output = step 18 input",
  "type": "object",
  "required": [
    "status",
    "panel_result",
    "cross_case_matrix",
    "cross_case_disagreements"
  ],
  "properties": {
    "status": {
      "const": "ACROSS_CASE_COMPLETE"
    },
    "panel_result": {
      "$ref": "aqrp://shared/panel_result"
    },
    "cross_case_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "coder_id",
          "codes"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "coder_id": {
            "type": "string",
            "minLength": 1
          },
          "codes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "quote": {
            "type": "string"
          },
          "narrative": {
            "type": "string"
          },
          "changes_dimension": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "cross_case_disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "coders"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "coders": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$comment": "Producer: pipeline.cjs panelStepGeneric(17, {matrixField:'cross_case_matrix', disField:'cross_case_disagreements', status:'ACROSS_CASE_COMPLETE'}). Upstream fields pass through verbatim."
}
