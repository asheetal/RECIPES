{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aqrp://step26_27",
  "title": "AQRP step 26 (surgeon) output = step 27 input",
  "type": "object",
  "required": [
    "status",
    "model_draft",
    "rdf_records"
  ],
  "properties": {
    "status": {
      "const": "MODEL_COMPLETE"
    },
    "model_draft": {
      "type": "object",
      "required": [
        "name",
        "summary",
        "tension",
        "phases",
        "arrows",
        "propositions",
        "evidence",
        "alternative_readings"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 20
        },
        "tension": {
          "type": "string",
          "minLength": 5
        },
        "phases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "arrows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "propositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "arrow",
              "supporting_record_ids",
              "quotes"
            ],
            "properties": {
              "arrow": {
                "type": "string",
                "minLength": 1
              },
              "supporting_record_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "quotes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "alternative_readings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "reading",
              "why_rejected"
            ],
            "properties": {
              "reading": {
                "type": "string",
                "minLength": 5
              },
              "why_rejected": {
                "type": "string",
                "minLength": 5
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "rdf_records": {
      "type": "array",
      "contains": {
        "type": "object",
        "required": [
          "rdf_id",
          "pool_id"
        ],
        "properties": {
          "rdf_id": {
            "const": "R26"
          },
          "pool_id": {
            "const": "P10"
          }
        }
      },
      "items": {
        "$ref": "aqrp://shared/rdf_record"
      }
    },
    "P10": {
      "$ref": "aqrp://shared/citation_pool"
    }
  },
  "additionalProperties": true,
  "$comment": "Producer: pipeline.cjs surgeonStep(26, {requiredFields:['model_draft'], rdfIds:['R26'], allowedPools:['P10'], status:'MODEL_COMPLETE'}). Exactly one RDF (R26) at this boundary; upstream fields pass through verbatim."
}