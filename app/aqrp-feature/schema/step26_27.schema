{ "$schema":"http://json-schema.org/draft-07/schema#", "$id":"aqrp://step26_27",
  "title":"AQRP step 26 (surgeon) output = step 27 input",
  "type":"object",
  "required":["status", "model_draft", "rdf_records"],
  "properties":{
    "status": {"const": "MODEL_COMPLETE"},
    "model_draft": {"not": {"type": "null"}},
    "rdf_records": {
      "type": "array",
      "contains": {"type": "object", "required": ["rdf_id", "pool_id"],
                     "properties": {"rdf_id": {"const": "R26"},
                                    "pool_id": {"const": "P10"}}},
      "items": {"$ref": "aqrp://shared/rdf_record"}
    },
    "P10": {"$ref": "aqrp://shared/citation_pool"}
  },
  "additionalProperties":true,
  "$comment":"Producer: pipeline.cjs surgeonStep(26, {requiredFields:[model_draft], rdfIds:['R26'], allowedPools:['P10'], status:'MODEL_COMPLETE'}). Exactly one RDF (R26) at this boundary; upstream fields pass through verbatim."
}
