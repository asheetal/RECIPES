{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aqrp://step28_29",
  "title": "AQRP step 28 (surgeon) output = step 29 input",
  "type": "object",
  "required": [
    "status",
    "diagram_script_params",
    "rdf_records"
  ],
  "properties": {
    "status": {
      "const": "DIAGRAM_PARAMS_COMPLETE"
    },
    "diagram_script_params": {
      "type": "object",
      "required": [
        "nodes",
        "paths",
        "labels",
        "layout"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "labels": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "nature": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "layout": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "rdf_records": {
      "type": "array",
      "contains": {
        "type": "object",
        "required": [
          "rdf_id",
          "pool_id"
        ],
        "properties": {
          "rdf_id": {
            "const": "R28"
          },
          "pool_id": {
            "const": "P11"
          }
        }
      },
      "items": {
        "$ref": "aqrp://shared/rdf_record"
      }
    },
    "P11": {
      "$ref": "aqrp://shared/citation_pool"
    }
  },
  "additionalProperties": true,
  "$comment": "Producer: pipeline.cjs surgeonStep(28, {requiredFields:['diagram_script_params'], rdfIds:['R28'], allowedPools:['P11'], status:'DIAGRAM_PARAMS_COMPLETE'}). Exactly one RDF (R28) at this boundary; upstream fields pass through verbatim."
}