{ "$schema":"http://json-schema.org/draft-07/schema#", "$id":"aqrp://step3_4",
  "title":"AQRP step 3 output = step 4 input",
  "type":"object",
  "required":["status","coding_brief","notes","rdf_records"],
  "properties":{
    "status":{"type":"string","minLength":1},
    "coding_brief":{"type":"object",
      "required":["code_for","ignore","flag","granularity"],
      "properties":{
        "code_for":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "ignore":{"type":"array","items":{"type":"string"}},
        "flag":{"type":"array","items":{"type":"string"}},
        "granularity":{"type":"string","minLength":1}
      },
      "additionalProperties":true},
    "notes":{"type":"string","minLength":600},
    "rdf_records":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"aqrp://shared/rdf_record"},
      "description":"R3 (pool P01) and R3a (pool P00) — enforced in pipeline.cjs."}
  },
  "additionalProperties":true }
