{ "$schema":"http://json-schema.org/draft-07/schema#", "$id":"aqrp://step4_5",
  "title":"AQRP step 4 output = step 5 input",
  "type":"object",
  "required":["status","code_matrix","disagreements"],
  "properties":{
    "status":{"const":"OPEN_CODING_COMPLETE"},
    "code_matrix":{"type":"array","items":{
      "type":"object","required":["record_id","coder_id","codes"],
      "properties":{
        "record_id":{"type":"string","minLength":1},
        "coder_id":{"type":"string","minLength":1},
        "codes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "quote":{"type":"string"}},
      "additionalProperties":true}},
    "disagreements":{"type":"array","items":{
      "type":"object","required":["record_id","coders"],
      "properties":{
        "record_id":{"type":"string","minLength":1},
        "coders":{"type":"object","additionalProperties":{"type":"array","items":{"type":"string"}}}},
      "additionalProperties":true}},
    "filtered_codes":{"type":"integer","minimum":0},
    "filtered_cells":{"type":"array","items":{"type":"string"}},
    "warnings":{"type":"array","items":{"$ref":"aqrp://shared/warning"}}
  },
  "additionalProperties":true }
