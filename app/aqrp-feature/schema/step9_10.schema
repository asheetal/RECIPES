{ "$schema":"http://json-schema.org/draft-07/schema#", "$id":"aqrp://step9_10",
  "title":"AQRP step 9 (search) output = step 10 input",
  "type":"object",
  "required":["status", "P04", "lit_map"],
  "properties":{
    "status": {"const": "LIT_SCAN_COMPLETE"},
    "P04": {"$ref": "aqrp://shared/citation_pool"},
    "lit_map": {"type": "array"}
  },
  "additionalProperties":true,
  "$comment":"Producer: pipeline.cjs searchStep(9, {poolId:'P04', status:'LIT_SCAN_COMPLETE', extraFields:['lit_map']}). Upstream fields from step 8 pass through verbatim."
}
