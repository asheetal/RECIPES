#!/usr/bin/env python3
import argparse, datetime, fcntl, hashlib, json, os, pathlib, shutil, subprocess, sys, tarfile, time, urllib.request
ROOT=pathlib.Path('/home/sheetal/librechat')
STATE=pathlib.Path('/var/lib/librechat/guard')
BACKUPS=ROOT/'data-backups'
def run(args,**kw):
    return subprocess.run(args,cwd=ROOT,check=True,**kw)
def capture(args):
    return run(args,stdout=subprocess.PIPE,text=True).stdout
def inspect(name):
    return json.loads(capture(['docker','inspect',name]))[0]
def mounts(name):
    return {m['Destination']:{'source':m['Source'],'type':m['Type'],'rw':m['RW']} for m in inspect(name)['Mounts']}
def baseline(): return json.loads((STATE/'storage.json').read_text())
def healthy():
    for _ in range(60):
        try:
            with urllib.request.urlopen('http://127.0.0.1:3080/',timeout=3) as r:
                if r.status==200:return
        except Exception:pass
        time.sleep(2)
    raise RuntimeError('LibreChat did not become healthy')
def check():
    for name,expected in baseline().items():
        live=mounts(name)
        for target,value in expected.items():
            if live.get(target)!=value:raise RuntimeError('Storage changed: '+name+' '+target)
    cfg=json.loads(capture(['docker','compose','config','--format','json']))
    v=[v for v in cfg['services']['api'].get('volumes',[]) if v.get('target')=='/app/uploads']
    wanted=baseline()['librechat']['/app/uploads']
    if len(v)!=1 or v[0].get('source')!=wanted['source'] or v[0].get('type')!=wanted['type'] or v[0].get('read_only',False):
        raise RuntimeError('STOP: Compose would change the uploads mount')
    run(['docker','exec','librechat','node','-e', 'const fs=require("fs"),p="/app/uploads/.guard-"+require("crypto").randomUUID();fs.writeFileSync(p,"ok",{flag:"wx",mode:0o600});fs.unlinkSync(p);'],stdout=subprocess.DEVNULL)

def upgrade():
    # UI patches must keep the previous image: no image upgrades or database migrations.
    check();old=inspect('librechat');oldimage=old['Image']
    cfg=json.loads(capture(['docker','compose','config','--format','json']))
    image=cfg['services']['api'].get('image')
    if not image or json.loads(capture(['docker','image','inspect',image]))[0]['Id']!=oldimage:
        raise RuntimeError('Image change blocked: use a separately reviewed application upgrade')
    run(['docker','stop','librechat'],stdout=subprocess.DEVNULL)
    try:
        # Record the stopped container upload tree so recreation cannot silently remove files.
        source=pathlib.Path(baseline()['librechat']['/app/uploads']['source'])
        before={str(p.relative_to(source)):hashlib.file_digest(p.open('rb'),'sha256').hexdigest() for p in source.rglob('*') if p.is_file() and not p.is_symlink()}
        run(['docker','compose','up','-d','--no-deps','--pull','never','--no-build','api'])
        healthy();check()
        for relative,digest in before.items():
            p=source/relative
            if not p.is_file() or hashlib.file_digest(p.open('rb'),'sha256').hexdigest()!=digest:
                raise RuntimeError('Upload changed during update: '+relative)
        (STATE/'last-good.json').write_text(json.dumps(cfg))
        print('Guarded UI deployment passed: storage unchanged; uploads verified; HTTP 200.')
    except Exception:
        run(['docker','compose','--project-directory',str(ROOT),'-p',old['Config']['Labels']['com.docker.compose.project'],'-f',str(STATE/'last-good.json'),'up','-d','--no-deps','--pull','never','--no-build','api'])
        print('Previous runtime configuration restored; review Compose files before retrying.')
        raise

def install():
    STATE.mkdir(mode=0o700,exist_ok=True)
    if not (STATE/'storage.json').exists():
        spec={'librechat':['/app/uploads'],'ChatMongoDB':['/data/db'],'code-interpreter-minio-1':['/var/lib/garage'],'librechat-vectordb-1':['/var/lib/postgresql/data'],'redis':['/data']}
        saved={}
        for name,targets in spec.items():
            live=mounts(name);saved[name]={}
            for target in targets:
                if target not in live:raise RuntimeError('Missing persistent storage: '+name+' '+target)
                saved[name][target]=live[target]
        (STATE/'storage.json').write_text(json.dumps(saved,indent=2))
    check()
    (STATE/'last-good.json').write_text(capture(['docker','compose','config','--format','json']))
    shutil.copy2(__file__,'/usr/local/sbin/lab-data-guard')
    os.chmod('/usr/local/sbin/lab-data-guard',0o700)
    print('Installed: storage checks and guarded UI deployments. No backups or cron jobs added.')
if __name__=='__main__':
    try:
        os.umask(0o077)
        if os.geteuid()!=0:raise RuntimeError('Run with sudo')
        parser=argparse.ArgumentParser();parser.add_argument('action',choices=['install','check','upgrade']);a=parser.parse_args()
        with open('/var/lock/lab-data-guard.lock','w') as lock:
            fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
            globals()[a.action]()
            if a.action=='check':print('Storage and upload write checks: PASS')
    except Exception as e:
        print('FAILED:',str(e),file=sys.stderr);sys.exit(1)
